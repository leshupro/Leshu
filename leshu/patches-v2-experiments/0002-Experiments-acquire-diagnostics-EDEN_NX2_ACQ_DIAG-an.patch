diff --git a/src/video_core/nx2_acq_diag.h b/src/video_core/nx2_acq_diag.h
new file mode 100644
index 0000000..1ede93b
--- /dev/null
+++ b/src/video_core/nx2_acq_diag.h
@@ -0,0 +1,137 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// EDEN_NX2_ACQ_DIAG=1: which semaphore words the split's front still drains for, and which engine
+// releases them. Logs the top words every 10 s.
+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+
+namespace VideoCommon::Nx2AcqDiag {
+
+enum Source : u32 {
+    SrcPullerWriteLong = 1,
+    SrcPullerRelease = 2,
+    SrcSemExecute = 4,
+    Src3DReport = 8,
+    SrcComputeReport = 16,
+    SrcQmdPlain = 32,
+    SrcQmdMax = 64,
+    SrcQmdAdd = 128,
+    SrcDma = 256,
+    SrcCpu = 512,
+};
+
+inline bool Enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_ACQ_DIAG");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+struct State {
+    std::mutex mutex;
+    std::unordered_map<u64, u32> sources; // device word -> Source bits
+    struct Word {
+        u64 drained{};
+        u64 met_after{};
+        u32 miss_bits{};
+        u32 last_value{};
+        u32 last_recorded{};
+    };
+    std::unordered_map<u64, Word> words;
+    std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+};
+
+inline State& Get() {
+    static State state;
+    return state;
+}
+
+inline void NoteSource(u64 device, u32 source) {
+    if (!Enabled()) {
+        return;
+    }
+    auto& s = Get();
+    std::scoped_lock lock{s.mutex};
+    s.sources[device & ~u64{3}] |= source;
+}
+
+/// A front drain for an acquire of `device` (miss: QueuedReleasePayload's reason).
+inline void NoteDrain(u64 device, u32 miss, u32 value, bool met_after, u32 recorded) {
+    if (!Enabled()) {
+        return;
+    }
+    auto& s = Get();
+    std::scoped_lock lock{s.mutex};
+    auto& word = s.words[device & ~u64{3}];
+    ++word.drained;
+    word.met_after += met_after ? 1 : 0;
+    word.miss_bits |= 1U << (miss & 7);
+    word.last_value = value;
+    word.last_recorded = recorded;
+}
+
+inline std::string SourceNames(u32 bits) {
+    static constexpr const char* names[] = {"writelong", "release", "sem_exec", "3d_report",
+                                            "cmp_report", "qmd_plain", "qmd_max", "qmd_add",
+                                            "dma", "cpu"};
+    std::string out;
+    for (u32 i = 0; i < 10; ++i) {
+        if (bits & (1U << i)) {
+            out += out.empty() ? names[i] : std::string{"+"} + names[i];
+        }
+    }
+    return out.empty() ? "unknown" : out;
+}
+
+inline void MaybeReport() {
+    if (!Enabled()) {
+        return;
+    }
+    auto& s = Get();
+    std::scoped_lock lock{s.mutex};
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s.start < std::chrono::seconds{10}) {
+        return;
+    }
+    s.start = now;
+    std::vector<std::pair<u64, State::Word>> top(s.words.begin(), s.words.end());
+    std::ranges::sort(top, [](const auto& a, const auto& b) { return a.second.drained > b.second.drained; });
+    u64 total{};
+    std::unordered_map<std::string, u64> by_source;
+    for (const auto& [device, word] : top) {
+        total += word.drained;
+        const auto it = s.sources.find(device);
+        by_source[SourceNames(it == s.sources.end() ? 0 : it->second)] += word.drained;
+    }
+    std::string summary;
+    for (const auto& [name, count] : by_source) {
+        summary += fmt::format(" {}={}", name, count);
+    }
+    LOG_INFO(HW_GPU, "AcqDiag: {} drains on {} words in 10 s, by release source:{}", total,
+             top.size(), summary);
+    for (size_t i = 0; i < std::min<size_t>(top.size(), 8); ++i) {
+        const auto& [device, word] = top[i];
+        const auto it = s.sources.find(device);
+        LOG_INFO(HW_GPU,
+                 "AcqDiag:   {:#x} drained {} met_after {} miss_bits {:#x} value {:#x} recorded "
+                 "{:#x} source {}",
+                 device, word.drained, word.met_after, word.miss_bits, word.last_value,
+                 word.last_recorded, SourceNames(it == s.sources.end() ? 0 : it->second));
+    }
+    s.words.clear();
+}
+
+} // namespace VideoCommon::Nx2AcqDiag
diff --git a/src/video_core/nx2_qmd_front.h b/src/video_core/nx2_qmd_front.h
new file mode 100644
index 0000000..b9f2ef3
--- /dev/null
+++ b/src/video_core/nx2_qmd_front.h
@@ -0,0 +1,299 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// EDEN_NX2_QMD_TRACK (experiment): the split's front mirrors the native QMD scheduler
+// (native_qmd.h) to know the semaphore releases queued compute work makes, so a GEQUAL acquire
+// of a word only QMD releases advance needs no drain when the releases already sent meet it.
+//   =1: use the prediction (no drain when it meets the acquire)
+//   =2: verify only: predict, drain anyway, log predictions the real word does not confirm
+// Ocarina's village drains ~700 times a second on two such words (a QMD add counter and a QMD
+// max release), and every one of them was met after the drain.
+//
+// Only the front thread touches this. Its scheduler state follows the same signals as the
+// back's, in the same order; descriptors come from guest memory (CPU-written QMDs) or from the
+// inline QMD words the front holds. A word another engine releases, or one whose real value ever
+// differs from the prediction, is not predicted again.
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <unordered_map>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "video_core/memory_manager.h"
+#include "video_core/nx2.h"
+
+namespace VideoCommon::Nx2QmdFront {
+
+using Descriptor = std::array<u32, 64>;
+
+inline int Mode() {
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_NX2_QMD_TRACK");
+        return value == nullptr ? 0 : value[0] == '2' ? 2 : value[0] == '1' ? 1 : 0;
+    }();
+    return mode;
+}
+
+class Mirror {
+public:
+    static Mirror& Get() {
+        static Mirror mirror;
+        return mirror;
+    }
+
+    /// The back writes an inline QMD's 256 bytes at `address` (method 0x107).
+    void InlineWrite(GPUVAddr address, const u32* qmd_words) {
+        if (overlay.size() > 8192) {
+            overlay.clear();
+        }
+        auto& descriptor = overlay[address];
+        std::copy_n(qmd_words, descriptor.size(), descriptor.begin());
+    }
+
+    /// A PCAS signal the back hands to NativeQmdScheduler::Signal.
+    void Signal(Tegra::MemoryManager& memory, GPUVAddr address, u32 argument) {
+        struct Pending {
+            GPUVAddr address;
+            u32 action;
+            u32 count;
+        };
+        std::array<Pending, 256> pending{};
+        size_t count = 1;
+        pending[0] = {address, argument & 15, ((argument >> 14) & 0x3ff) + 1};
+        for (size_t i = 0; i < count; ++i) {
+            const auto request = pending[i];
+            if (states.size() >= 4096 && !states.contains(request.address)) {
+                std::erase_if(states, [](const auto& entry) {
+                    return entry.second.completed && entry.second.deferred == 0;
+                });
+                if (states.size() >= 4096) {
+                    return Lost();
+                }
+            }
+            auto& state = states[request.address];
+            if (request.action == 3 || request.action == 2) {
+                if (request.action == 3 || !state.loaded) {
+                    if (!Read(memory, request.address, state.descriptor)) {
+                        return Lost();
+                    }
+                    const auto& qmd = state.descriptor;
+                    if ((qmd[18] & 0xff) != 0x30 || (qmd[4] & 0x100)) {
+                        return Lost();
+                    }
+                    state.dependencies = static_cast<s32>((qmd[4] >> 14) & 0xffff) + state.deferred;
+                    state.deferred = 0;
+                    state.loaded = true;
+                    state.completed = false;
+                }
+                state.scheduled = true;
+            } else if (request.action == 7 || request.action == 12) {
+                const s32 delta = request.action == 7 ? -static_cast<s32>(request.count)
+                                                      : static_cast<s32>(request.count);
+                if (!state.loaded || state.completed) {
+                    state.deferred += delta;
+                    continue;
+                }
+                state.dependencies += delta;
+            } else if (request.action == 0 || request.action == 1) {
+                continue;
+            } else {
+                return Lost();
+            }
+            if (!state.loaded || !state.scheduled || state.completed || state.dependencies > 0) {
+                continue;
+            }
+            if (state.dependencies < 0 || !Read(memory, request.address, state.descriptor)) {
+                return Lost();
+            }
+            const auto qmd = state.descriptor;
+            if ((qmd[18] & 0xff) != 0x30 || (qmd[4] & 0x100)) {
+                return Lost();
+            }
+            state.completed = true;
+            for (const u32 base : ReleaseSlots) {
+                const u32 flags = qmd[base + 1];
+                if (!(flags & (1U << 23))) {
+                    continue;
+                }
+                const GPUVAddr destination = (GPUVAddr{flags & 0xff} << 32) | qmd[base];
+                const auto device = memory.GpuToCpuAddress(destination);
+                if (!device) {
+                    return Lost();
+                }
+                Release(*device & ~u64{3}, qmd[base + 2], flags);
+            }
+            if (qmd[16] & 1) {
+                const u32 action = (qmd[16] >> 1) & 7;
+                if ((action != 4 && action != 3 && action != 1) || count == pending.size()) {
+                    return Lost();
+                }
+                pending[count++] = {GPUVAddr{qmd[15]} << 8,
+                                    action == 4 ? 7U : action == 3 ? 3U : 2U, 1};
+            }
+            if (qmd[16] & (1U << 5)) {
+                return Lost();
+            }
+        }
+    }
+
+    /// Another engine (or a release the front can't follow) writes this word.
+    void NoteOtherWriter(u64 device) {
+        if (const auto it = words.find(device & ~u64{3}); it != words.end()) {
+            it->second.excluded = true;
+        }
+    }
+
+    /// Whether the releases sent so far make the word reach `value` (GEQUAL).
+    bool Predicts(u64 device, u32 value) {
+        ++stats.asked;
+        if (lost) {
+            return false;
+        }
+        const auto it = words.find(device & ~u64{3});
+        if (it == words.end() || !it->second.base_valid || it->second.excluded) {
+            return false;
+        }
+        const u32 predicted = Predicted(it->second);
+        if (predicted < it->second.base) {
+            return false; // wrapped
+        }
+        return predicted >= value;
+    }
+
+    /// After a drain: the word's real value, with every release sent so far done.
+    void Observe(u64 device, u32 real, u32 value, bool predicted_met) {
+        auto& word = words[device & ~u64{3}];
+        if (predicted_met) {
+            ++stats.verified;
+            if (real < value) {
+                ++stats.wrong;
+                word.excluded = true;
+                if (stats.wrong <= 16) {
+                    LOG_WARNING(HW_GPU, "QmdTrack: predicted {:#x} >= {:#x} at {:#x}, real {:#x}",
+                                Predicted(word), value, device, real);
+                }
+            }
+        }
+        if (word.base_valid && !word.excluded && real != Predicted(word)) {
+            ++stats.mismatch;
+            word.excluded = true;
+            if (stats.mismatch <= 16) {
+                LOG_WARNING(HW_GPU, "QmdTrack: {:#x} predicted {:#x}, real {:#x}: not tracked",
+                            device, Predicted(word), real);
+            }
+        }
+        word.base = real;
+        word.add = 0;
+        word.max = 0;
+        word.has_max = false;
+        word.base_valid = true;
+        lost = false;
+        MaybeReport();
+    }
+
+    void CountFast() {
+        ++stats.fast;
+    }
+
+private:
+    struct State {
+        Descriptor descriptor{};
+        s32 dependencies{};
+        s32 deferred{};
+        bool loaded{};
+        bool scheduled{};
+        bool completed{};
+    };
+    struct Word {
+        u32 base{};
+        u32 add{};
+        u32 max{};
+        bool has_max{};
+        bool base_valid{};
+        bool excluded{};
+        bool used_add{};
+        bool used_max{};
+    };
+    static constexpr std::array<u32, 3> ReleaseSlots{24, 28, 52};
+
+    static u32 Predicted(const Word& word) {
+        u32 value = word.base + word.add;
+        if (word.has_max) {
+            value = (std::max)(value, word.max);
+        }
+        return value;
+    }
+
+    void Release(u64 device, u32 payload, u32 flags) {
+        auto& word = words[device];
+        if (flags & (1U << 26)) {
+            word.add += payload;
+            word.used_add = true;
+        } else if (flags & (1U << 19)) {
+            word.max = word.has_max ? (std::max)(word.max, payload) : payload;
+            word.has_max = true;
+            word.used_max = true;
+        } else {
+            word.excluded = true; // plain writes: left to the queued-release path
+        }
+        if (word.used_add && word.used_max) {
+            word.excluded = true; // max(base + adds, max) is only right in one order
+        }
+    }
+
+    bool Read(Tegra::MemoryManager& memory, GPUVAddr address, Descriptor& descriptor) {
+        if (const auto it = overlay.find(address); it != overlay.end()) {
+            descriptor = it->second;
+            return true;
+        }
+        if (!memory.IsFullyMappedRange(address, sizeof(descriptor))) {
+            return false;
+        }
+        for (GPUVAddr page = address & ~GPUVAddr{0xfff}; page < address + sizeof(descriptor);
+             page += 0x1000) {
+            const auto device = memory.GpuToCpuAddress(page);
+            if (!device || Tegra::Nx2IsGpuWritten(*device)) {
+                return false; // GPU work may have written it: the front's copy may be stale
+            }
+        }
+        memory.ReadBlockUnsafe(address, descriptor.data(), sizeof(descriptor));
+        return true;
+    }
+
+    void Lost() {
+        // The mirror may now differ from the back: predict nothing until the next drain shows
+        // the real words (Observe).
+        lost = true;
+        ++stats.lost;
+    }
+
+    void MaybeReport() {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - report_start < std::chrono::seconds{10}) {
+            return;
+        }
+        report_start = now;
+        LOG_INFO(HW_GPU,
+                 "QmdTrack: asked {} fast {} verified {} wrong {} mismatch {} lost {} words {} "
+                 "states {} (10 s)",
+                 stats.asked, stats.fast, stats.verified, stats.wrong, stats.mismatch, stats.lost,
+                 words.size(), states.size());
+        stats = {};
+    }
+
+    std::unordered_map<GPUVAddr, State> states;
+    std::unordered_map<GPUVAddr, Descriptor> overlay;
+    std::unordered_map<u64, Word> words;
+    bool lost{};
+    struct Stats {
+        u64 asked{}, fast{}, verified{}, wrong{}, mismatch{}, lost{};
+    } stats;
+    std::chrono::steady_clock::time_point report_start = std::chrono::steady_clock::now();
+};
+
+} // namespace VideoCommon::Nx2QmdFront
